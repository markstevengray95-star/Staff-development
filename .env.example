# Supabase server-only secret used by the Stripe webhook.
# IMPORTANT: this must be the service-role key for the CPD project above,
# never a key from the tutoring app/project.
SUPABASE_SERVICE_ROLE_KEY=

# AI CPD Coach — Gemini is the primary provider.
# Keep GEMINI_API_KEY server-only. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_COACH_MODEL=gemini-3.8-flash

# Optional secondary provider. If Gemini is unavailable, the coach can use
# OpenAI before falling back to the built-in evidence-aware Smart Coach.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-luna

# Stripe server-only secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

